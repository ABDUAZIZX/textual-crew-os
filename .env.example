# Textual Crew OS - environment configuration template.
# Copy to `.env` and adjust. NEVER commit the real `.env`.

# ============================================================
# Data storage
# ============================================================
# Where SQLite, JSONL audit log, and traces live.
# Default: ~/.local/share/textual-crew-os (XDG-compliant).
#CREW_DATA_DIR=

# ============================================================
# Ollama (local LLM backend)
# ============================================================
# MUST point to a loopback address. Binding Ollama publicly is a
# CRITICAL security risk - anyone on the network can use your GPU
# and your locally-loaded models.
CREW_OLLAMA_HOST=http://127.0.0.1:11434
CREW_OLLAMA_TIMEOUT=120

# ============================================================
# Models (pulled by install.sh via `ollama pull`)
# ============================================================
# install.sh reads these names from .env (not hardcoded) and pulls them.
# The values below MUST match the agent defaults baked into the source
# (see src/crew_os/agents/*.py and orchestration/supervisor_tier*.py).
# Override only if you know the corresponding agent default also changed.
CREW_ROUTER_MODEL=qwen2.5:3b
CREW_CODER_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
CREW_AUDITOR_MODEL=qwen3:8b
CREW_SUPERVISOR_LOCAL_MODEL=qwen3:14b
CREW_EMBED_MODEL=nomic-embed-text

# Defensive (Blue Team) agent uses a custom Ollama model built from
# models/crew-defender.Modelfile. install.sh runs `ollama create` for it.
# This is the BASE model the Modelfile is FROM; it is pulled first.
CREW_DEFENDER_MODEL=crew-defender
CREW_DEFENDER_BASE_MODEL=qwen2.5:7b-instruct-q4_K_M

# ============================================================
# Anthropic API (optional - Tier-2 Supervisor)
# ============================================================
# Leave empty to run fully offline. When unset, Tier-2 falls back
# to local qwen3:14b (CPU-bound; slower but functional).
#CREW_ANTHROPIC_API_KEY=sk-ant-...
CREW_ANTHROPIC_MODEL=claude-opus-4-7

# ============================================================
# Web dashboard
# ============================================================
# host MUST be loopback. The dashboard exposes agent control;
# exposing it publicly turns the host into a remote-controlled bot.
CREW_WEB_HOST=127.0.0.1
CREW_WEB_PORT=8765

# ============================================================
# Logging
# ============================================================
# DEBUG | INFO | WARNING | ERROR
CREW_LOG_LEVEL=INFO

# ============================================================
# LAB_MODE (offensive agent) - disabled by default
# ============================================================
# Setting CREW_LAB_MODE=1 alone is NOT enough. The system also requires:
#   1) ~/.crew/lab_consent.token with a recent unix timestamp (< 7 days)
#   2) chmod 600 on that token (loose perms are rejected)
#   3) interactive CLI confirm at the first offensive task per session
#
# Without all three gates the offensive agent will refuse to start.
# Activation is recorded in the audit log with full scope metadata.
#CREW_LAB_MODE=0
